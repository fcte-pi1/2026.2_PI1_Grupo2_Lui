# URL do PostgreSQL usado pelo Prisma.
DATABASE_URL="postgresql://micromouse:<SENHA>@localhost:5433/micromouse?schema=public"
PORT=3000

# Porta serial virtual criada pelo sistema operacional para Bluetooth Classic SPP.
# Linux: /dev/rfcomm0 | Windows: COM5 | macOS: /dev/cu.<nome-do-dispositivo>
MM_BLUETOOTH_SERIAL_PORT=/dev/rfcomm0
MM_BLUETOOTH_SERIAL_BAUD_RATE=115200
